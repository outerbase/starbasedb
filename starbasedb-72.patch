+            createMockCtx()
+        )
+        expect(res.status).toBe(403)
+    })
+
+    it('should return 400 when external data source is not configured', async () => {
+        const plugin = new ReplicaPlugin({ tables: ['users'] })
+        const starbase = new StarbaseDB({
